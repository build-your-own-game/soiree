# Les routes des relais, importées par le Caddy de la prod (infra, prod/proxy).
#
# Un relais a deux portes. Les chemins sous /_relais/ vont à celle de
# l'étagère de l'hôte, qui présente sa clé ; tout le reste vient des
# téléphones, et le relais le porte tel quel jusqu'au jeu.
(soiree_relais) {
	handle /_relais/* {
		reverse_proxy {args[0]}:8081
	}
	handle {
		# Les pages d'un jeu pèsent de 0,6 à 6 Mo et partent telles quelles de
		# l'ordinateur de l'hôte : compressées ici, un téléphone en reçoit de
		# trois à cinq fois moins. Le lien d'une page avec le jeu n'est pas
		# touché.
		encode zstd gzip
		reverse_proxy {args[0]}:8080
	}
}

# Un nom par hôte : le sien mène à son relais (deploy/compose.yaml).
relais.soiree.colvenalabs.com {
	import soiree_relais soiree-relais
}

ami.relais.soiree.colvenalabs.com {
	import soiree_relais soiree-relais-ami
}
